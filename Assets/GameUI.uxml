<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" authoring-id="-1165872441" editor-extension-mode="False">
    <ui:Label text="Current score:" name="Label" style="height: 58px; width: 307px; -unity-text-auto-size: none; font-size: 40px; -unity-text-align: upper-left; -unity-font-style: bold; top: 0; align-items: flex-end; align-self: flex-end; color: rgb(26, 26, 26); -unity-background-scale-mode: stretch-to-fill; white-space: normal; text-overflow: ellipsis; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(255, 255, 255);">
        <ui:Label text="" name="ScoreText" style="height: 57px; width: 270px; -unity-text-auto-size: none; font-size: 40px; -unity-text-align: upper-right; -unity-font-style: bold; top: 54px; align-items: flex-end; align-self: flex-end; background-color: rgb(245, 245, 245); color: rgb(26, 26, 26);"/>
    </ui:Label>
    <ui:Label text="High score:" name="Label" style="height: 62px; width: 267px; -unity-text-auto-size: none; -unity-text-align: upper-left; align-items: flex-start; justify-content: flex-start; align-self: flex-start; font-size: 40px; -unity-font-style: bold; text-overflow: ellipsis; top: 0; left: auto; align-content: stretch; position: absolute; white-space: normal; background-color: rgb(220, 220, 220);">
        <ui:Label text="" name="HighScoreText" style="height: 61px; width: 235px; -unity-text-auto-size: none; -unity-text-align: upper-right; align-items: flex-start; justify-content: flex-start; align-self: flex-start; font-size: 40px; -unity-font-style: bold; text-overflow: ellipsis; top: 54px; left: auto; align-content: stretch; position: relative; background-color: rgb(255, 255, 255);"/>
    </ui:Label>
    <ui:VisualElement name="gameOverPanel" enabled="true" style="flex-grow: 1; top: 115px; -unity-background-scale-mode: scale-to-fit; visibility: visible; display: flex; position: relative;">
        <ui:Label text="Game Over&#10;" name="GameOver" style="position: relative; top: auto; left: auto; height: 62px; width: 714px; -unity-text-auto-size: none; -unity-text-align: upper-center; color: rgb(255, 0, 0); justify-content: center; -unity-font-style: bold; font-size: 50px;"/>
        <ui:Label text="" name="GameOverScoreText" style="height: 56px; width: 715px; -unity-text-auto-size: none; font-size: 40px; -unity-text-align: upper-center; -unity-font-style: bold; top: -5px;"/>
        <ui:Label text="" name="GameOverHighScoreText" style="height: 60px; width: 713px; -unity-text-auto-size: none; -unity-text-align: middle-center; align-items: center; justify-content: space-between; align-self: center; font-size: 40px; -unity-font-style: bold; text-overflow: ellipsis; top: auto; left: 0; color: rgb(178, 178, 178);"/>
        <ui:Button text="Restart&#10;" name="RestartButton" focusable="false" style="height: 68px; width: 307px; display: flex; visibility: visible; -unity-font-style: bold; transform-origin: center; justify-content: space-around; align-items: center; white-space: nowrap; align-self: center; align-content: center; -unity-text-align: upper-center; font-size: 30px; position: relative; top: auto; left: auto; right: auto; bottom: auto; -unity-text-auto-size: none; letter-spacing: 0; text-shadow: 100px 100px 0 rgba(0, 0, 0, 0);"/>
        <ui:Button text="Return to main menu&#10;" name="MainMenuButton" style="height: 93px; width: 307px; display: flex; visibility: visible; -unity-font-style: bold; transform-origin: center; justify-content: space-around; align-items: center; white-space: normal; align-self: center; align-content: center; -unity-text-align: upper-center; font-size: 30px; position: relative; top: 35px; left: auto; right: auto; bottom: auto; flex-direction: column; -unity-text-auto-size: none;"/>
    </ui:VisualElement>
</ui:UXML>
